<%
  com.botica.model.Usuario navU = (com.botica.model.Usuario) session.getAttribute("usuario");
  String ctx = request.getContextPath();
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= com.botica.util.Html.esc(titulo) %> · Botica Bloome</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="<%= ctx %>/css/botica.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-botica sticky-top">
  <div class="container">
    <a class="navbar-brand" href="<%= ctx %>/index.jsp"><i class="bi bi-capsule-pill me-1"></i> Botica Bloome</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menuPrincipal">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="<%= ctx %>/index.jsp">Inicio</a></li>
        <li class="nav-item"><a class="nav-link" href="<%= ctx %>/catalogo.jsp">Catálogo</a></li>
      </ul>
      <% if (navU == null) { %>
        <div class="d-flex gap-2">
          <a class="btn btn-outline-primary" href="<%= ctx %>/login.jsp">Iniciar sesión</a>
          <a class="btn btn-primary" href="<%= ctx %>/registro.jsp">Crear cuenta</a>
        </div>
      <% } else { %>
        <div class="dropdown">
          <button class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">
            <i class="bi bi-person-circle me-1"></i> <%= com.botica.util.Html.esc(navU.getNombre()) %>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><span class="dropdown-item-text text-muted small"><%= com.botica.util.Html.esc(navU.getRol()) %></span></li>
            <li><a class="dropdown-item" href="<%= ctx %>/panel"><i class="bi bi-speedometer2 me-2"></i>Mi panel</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="<%= ctx %>/logout"><i class="bi bi-box-arrow-right me-2"></i>Salir</a></li>
          </ul>
        </div>
      <% } %>
    </div>
  </div>
</nav>
